<aside class="sidebar">
  <div class="sidebar-title">{% if lang == 'ko' %}{{ ko.sidebar_episodes }}{% else %}{{ en.sidebar_episodes }}{% endif %}</div>
  
  {% for ep in episodes %}
  <div class="ep-item {% if slug == ep.slug %}active{% endif %}"
       data-slug="{{ ep.slug }}">
    <div class="ep-num">
      EP {{ ep.episode }}
    </div>
    <div class="ep-title">{{ ep.titles[lang] }}</div>
  </div>
  {% endfor %}
</aside>
